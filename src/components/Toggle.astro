---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<details class="not-prose group my-5 rounded-lg border border-hairline bg-surface px-4 py-3">
  <summary class="flex cursor-pointer list-none items-center gap-2 text-[0.95rem] font-medium select-none [&::-webkit-details-marker]:hidden">
    <svg
      class="size-3.5 shrink-0 text-ink-faint transition-transform duration-150 group-open:rotate-90"
      viewBox="0 0 16 16"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M6 3.5 11 8l-5 4.5v-9Z"></path>
    </svg>
    {title}
  </summary>
  <div class="mt-3 border-t border-hairline pt-3 text-[0.95rem] leading-relaxed text-ink-soft [&_code]:font-mono [&_code]:text-[0.85em] [&_p]:m-0 [&_p+p]:mt-2 [&_ul]:m-0 [&_ul]:list-disc [&_ul]:pl-5">
    <slot />
  </div>
</details>
