---
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/posts', label: 'Posts' },
  { href: '/log', label: 'Log' },
  { href: '/series', label: 'Series' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
---

<header class="mx-auto w-full max-w-[45rem] px-5 pt-8 pb-10 sm:px-6 sm:pt-10">
  <div class="flex items-baseline justify-between gap-4">
    <a href="/" class="text-2xl leading-none font-bold">
      Latents <span class="italic text-accent">&amp;</span> Logs
    </a>
    <nav class="flex items-center gap-4 text-[0.92rem] text-ink-soft sm:gap-5">
      {
        nav.map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              'transition-colors hover:text-ink',
              path.startsWith(href) && 'text-ink underline decoration-accent/50 underline-offset-4',
            ]}
          >
            {label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
