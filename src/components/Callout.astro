---
interface Props {
  emoji?: string;
  tone?: 'neutral' | 'iris' | 'amber' | 'teal';
}

const { emoji = '💡', tone = 'neutral' } = Astro.props;
const tones = {
  neutral: 'bg-ink/[0.04] border-hairline',
  iris: 'bg-iris/[0.07] border-iris/25',
  amber: 'bg-amber/[0.08] border-amber/25',
  teal: 'bg-teal/[0.07] border-teal/25',
};
---

<aside class:list={['not-prose my-6 flex gap-3 rounded-lg border px-4 py-3.5', tones[tone]]}>
  <span class="select-none text-[1.05rem] leading-[1.6]" aria-hidden="true">{emoji}</span>
  <div class="text-[0.95rem] leading-relaxed text-ink [&_a]:text-accent [&_a]:underline [&_code]:font-mono [&_code]:text-[0.85em] [&_p]:m-0 [&_p+p]:mt-2">
    <slot />
  </div>
</aside>
