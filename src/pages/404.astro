---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <div class="pt-20 text-center">
    <p class="font-mono text-[0.85rem] text-ink-faint">404</p>
    <h1 class="mt-3 font-serif text-[2rem] tracking-tight">This page diffused back to noise.</h1>
    <p class="mt-4 text-ink-soft">
      Try the <a href="/" class="text-accent underline underline-offset-3">home page</a> or
      <a href="/posts" class="text-accent underline underline-offset-3">all posts</a>.
    </p>
  </div>
</Base>
