---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPublishedPosts } from '../lib/posts';
import { SITE, TRACKS, type TrackId } from '../site';

const posts = await getPublishedPosts();
const recent = posts.slice(0, 6);
const count = (track: TrackId) => posts.filter((p) => p.data.track === track).length;
const border = { iris: 'hover:border-iris/50', amber: 'hover:border-amber/50', teal: 'hover:border-teal/50' };
const text = { iris: 'text-iris', amber: 'text-amber', teal: 'text-teal' };
---

<Base>
  <section class="reveal pt-6 sm:pt-12" style="--reveal-i: 0">
    <h1 class="font-serif text-[2.3rem] leading-[1.15] tracking-tight sm:text-[2.7rem]">
      Sampling structure<br />out of <span class="italic text-accent">noise</span>, in public.
    </h1>
    <p class="mt-5 max-w-[36rem] text-[1.02rem] leading-relaxed text-ink-soft">
      I'm {SITE.author}. This is my study garden — working notes on diffusion &amp; video
      generation, agentic systems, and the distributed systems that serve them. Notes start as
      🌱 seeds and grow; nothing here waits to be perfect before it's published.
    </p>
  </section>

  <section class="mt-12 grid gap-3 sm:grid-cols-3">
    {
      (Object.entries(TRACKS) as [TrackId, (typeof TRACKS)[TrackId]][]).map(([id, t], i) => (
        <a
          href={`/posts/?track=${id}`}
          class:list={[
            'reveal group rounded-xl border border-hairline bg-surface p-4 transition-colors',
            border[t.color],
          ]}
          style={`--reveal-i: ${i + 1}`}
        >
          <p class:list={['font-serif text-[1.2rem] italic', text[t.color]]}>{t.label}</p>
          <p class="mt-0.5 text-[0.82rem] font-medium tracking-wide uppercase">{t.sub}</p>
          <p class="mt-2 text-[0.85rem] leading-relaxed text-ink-soft">{t.blurb}</p>
          <p class="mt-3 font-mono text-[0.75rem] text-ink-faint">
            {count(id)} {count(id) === 1 ? 'post' : 'posts'}
          </p>
        </a>
      ))
    }
  </section>

  <section class="mt-14">
    <div class="reveal flex items-baseline justify-between" style="--reveal-i: 4">
      <h2 class="font-serif text-[1.4rem] tracking-tight">Recently tended</h2>
      <a href="/posts" class="text-[0.88rem] text-ink-faint transition-colors hover:text-accent">All posts →</a>
    </div>
    <div class="mt-2">
      <PostList posts={recent} revealFrom={5} />
    </div>
  </section>
</Base>
