---
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, slugifySeries } from '../../lib/posts';

const posts = await getPublishedPosts();
const bySeries = new Map<string, typeof posts>();
for (const p of posts) {
  if (!p.data.series) continue;
  bySeries.set(p.data.series, [...(bySeries.get(p.data.series) ?? []), p]);
}
---

<Base title="Series" description="Multi-part study threads: courses, from-scratch builds, deep dives.">
  <h1 class="font-bold text-[2rem]">Series</h1>
  <p class="mt-3 text-ink-soft">
    Multi-part threads — course walkthroughs and from-scratch builds that grow one post at a time.
  </p>

  {
    bySeries.size === 0 ? (
      <p class="mt-10 rounded-lg border border-dashed border-hairline px-5 py-8 text-center text-ink-faint">
        🌱 No series yet — the first one is germinating.
      </p>
    ) : (
      <ul class="mt-8 space-y-4">
        {[...bySeries.entries()].map(([name, items]) => (
          <li>
            <a
              href={`/series/${slugifySeries(name)}/`}
              class="group block rounded-xl border border-hairline bg-surface p-5 transition-colors hover:border-accent/40"
            >
              <h2 class="font-bold text-[1.2rem] transition-colors group-hover:text-accent">{name}</h2>
              <p class="mt-1 font-mono text-[0.78rem] text-ink-faint">
                {items.length} {items.length === 1 ? 'part' : 'parts'}
              </p>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
