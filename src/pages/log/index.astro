---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('log')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const entryCount = entries.length;
const paperCount = new Set(entries.flatMap((e) => (e.data.papers ?? []).map((p) => p.title)))
  .size;

const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Base title="Reading Log" description="A tiny trace per day: what I read, what stuck, what's still open.">
  <section class="reveal pt-2 sm:pt-6" style="--reveal-i: 0">
    <h1 class="font-bold text-[2rem]">Reading Log</h1>
    <p class="mt-3 text-[1.02rem] leading-relaxed text-ink-soft">
      A tiny trace per day: what I read, what stuck, what's still open.
    </p>
    <p class="mt-4 font-mono text-[0.78rem] text-ink-faint">
      {entryCount} {entryCount === 1 ? 'entry' : 'entries'} · {paperCount}{' '}
      {paperCount === 1 ? 'paper' : 'papers'} touched
    </p>
  </section>

  <ul class="reveal mt-4 divide-y divide-hairline" style="--reveal-i: 1">
    {
      rendered.map(({ entry, Content }) => (
        <li class="py-6">
          <p class="font-mono text-[0.78rem] text-ink-faint">
            <time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time>
          </p>
          <div class="prose mt-2 max-w-none">
            <Content />
          </div>
          {entry.data.papers && entry.data.papers.length > 0 && (
            <ul class="mt-3 space-y-1">
              {entry.data.papers.map((p) => (
                <li class="text-[0.88rem] leading-relaxed text-ink-soft">
                  {p.url ? (
                    <a
                      href={p.url}
                      class="underline decoration-1 underline-offset-2 transition-opacity hover:opacity-75"
                    >
                      {p.title}
                    </a>
                  ) : (
                    p.title
                  )}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</Base>
