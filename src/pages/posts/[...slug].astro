---
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import TrackChip from '../../components/TrackChip.astro';
import Callout from '../../components/Callout.astro';
import Toggle from '../../components/Toggle.astro';
import Figure from '../../components/Figure.astro';
import { render } from 'astro:content';
import { getPublishedPosts, slugifySeries } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);

const all = await getPublishedPosts();
const siblings = post.data.series
  ? all
      .filter((p) => p.data.series === post.data.series)
      .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base title={post.data.title} description={post.data.description}>
  <article class="pt-2 sm:pt-6">
    <header class="reveal" style="--reveal-i: 0">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <TrackChip track={post.data.track} />
        <StatusBadge status={post.data.status} />
        {post.data.draft && (
          <span class="rounded-full bg-amber/15 px-2 py-px text-[0.72rem] font-medium text-amber uppercase">Draft</span>
        )}
      </div>
      <h1 class="mt-3 font-bold text-[2rem] leading-[1.2] sm:text-[2.25rem]">
        {post.data.title}
      </h1>
      <p class="mt-3 text-[1.02rem] leading-relaxed text-ink-soft">{post.data.description}</p>
      <p class="mt-4 font-mono text-[0.78rem] text-ink-faint">
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        {post.data.updated && <span> · tended {fmt(post.data.updated)}</span>}
      </p>
    </header>

    {
      post.data.series && (
        <nav class="reveal mt-7 rounded-lg border border-hairline bg-surface px-4 py-3" style="--reveal-i: 1">
          <p class="text-[0.78rem] tracking-wide text-ink-faint uppercase">
            Series ·{' '}
            <a href={`/series/${slugifySeries(post.data.series)}/`} class="text-accent hover:underline">
              {post.data.series}
            </a>
          </p>
          <ol class="mt-2 space-y-1">
            {siblings.map((p, i) => (
              <li class="text-[0.9rem]">
                <span class="font-mono text-[0.75rem] text-ink-faint">{String(i + 1).padStart(2, '0')}</span>{' '}
                {p.id === post.id ? (
                  <span class="font-medium">{p.data.title}</span>
                ) : (
                  <a href={`/posts/${p.id}/`} class="text-ink-soft transition-colors hover:text-accent">
                    {p.data.title}
                  </a>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    {
      toc.length > 2 && (
        <details class="reveal group mt-7 rounded-lg border border-hairline bg-surface px-4 py-3" style="--reveal-i: 1">
          <summary class="cursor-pointer list-none text-[0.78rem] tracking-wide text-ink-faint uppercase select-none [&::-webkit-details-marker]:hidden">
            On this page <span class="inline-block transition-transform group-open:rotate-90">›</span>
          </summary>
          <ol class="mt-2 space-y-1">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="text-[0.9rem] text-ink-soft transition-colors hover:text-accent">
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <div class="prose reveal mt-8 max-w-none" style="--reveal-i: 2">
      <Content components={{ Callout, Toggle, Figure }} />
    </div>

    <footer class="mt-14 border-t border-hairline pt-6">
      {
        post.data.tags.length > 0 && (
          <p class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="rounded-full border border-hairline px-2.5 py-0.5 font-mono text-[0.75rem] text-ink-faint">
                {tag}
              </span>
            ))}
          </p>
        )
      }
      <p class="mt-5 text-[0.9rem] text-ink-faint">
        Spotted an error, or want to talk about this? Find me on{' '}
        <a href="https://github.com/maxx1031" class="text-accent hover:underline">GitHub</a>.
      </p>
    </footer>
  </article>
</Base>
